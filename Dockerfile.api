# TrustLens API image (Python 3.11)
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# libpango/harfbuzz/fonts: WeasyPrint (Phase 19 PDF reports) system libraries
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libpq5 curl \
        libpango-1.0-0 libpangoft2-1.0-0 \
        libharfbuzz0b libharfbuzz-subset0 \
        fonts-dejavu-core shared-mime-info \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml backend/README.md backend/alembic.ini ./

# Dependency layer keyed on pyproject only: install against an empty `app`
# package so code edits don't reinstall every dependency.
RUN pip install --upgrade pip \
    && mkdir app && touch app/__init__.py \
    && pip install .

COPY backend/app ./app
COPY backend/alembic ./alembic

RUN pip install --no-deps .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
