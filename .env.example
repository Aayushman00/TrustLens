# -----------------------------------------------------------------------------
# TrustLens Phase 2 — environment template
# Copy to `.env` at the repo root:  cp .env.example .env
# Inside Docker Compose, use service hostnames (postgres, redis, minio).
# For native `make dev-*` against Compose infra, use 127.0.0.1 hostnames.
# -----------------------------------------------------------------------------

APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# Sync SQLAlchemy URL (psycopg2). Phase 2 uses sync ping only — no async engine.
# Compose (containers): host = postgres
# Native host → Compose Postgres: host = 127.0.0.1
DATABASE_URL=postgresql+psycopg2://trustlens:trustlens@postgres:5432/trustlens
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=trustlens
POSTGRES_DB=trustlens
POSTGRES_PORT=5432

# Redis (broker/cache). Compose host = redis; native = 127.0.0.1
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# MinIO (S3-compatible). Compose host = minio; API port 9000, console 9001.
# Workers/API must use http://minio:9000 inside the Compose network (not localhost).
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=trustlens
S3_REGION=us-east-1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# JWT auth (Phase 5). Generate a real secret outside development/test —
# the API fails fast at startup if APP_ENV != development/test and this is
# still the placeholder value.
JWT_SECRET=change-me-phase5-placeholder
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Dev seed user passwords (make seed-users). Defaults are used if unset —
# override for anything beyond local development.
SEED_ADMIN_PASSWORD=trustlens-admin-dev
SEED_RESEARCHER_PASSWORD=trustlens-researcher-dev
SEED_REVIEWER_PASSWORD=trustlens-reviewer-dev

# Optional — Hugging Face Hub token (Phase 6 model import). Only required for
# gated/private repos; public model metadata import works without it.
HF_TOKEN=

# Worker heartbeat interval (seconds) — only used by the deprecated heartbeat shell
WORKER_HEARTBEAT_SECONDS=30

# Celery producer (Phase 7). Set true only for special eager-mode experiments;
# normal compose/tests leave this false and mock enqueue or call the pipeline directly.
CELERY_TASK_ALWAYS_EAGER=false

# Report PDF projection (Phase 19). The API image ships WeasyPrint OS libs
# (Pango/HarfBuzz); set false to skip PDFs — reports then return pdf_uri=null
# and remain JSON (canonical) + HTML only.
REPORT_PDF_ENABLED=true
