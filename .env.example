# -----------------------------------------------------------------------------
# TrustLens — environment template
# Copy to `.env` at the repo root:  cp .env.example .env
#
# Hostname cheat sheet:
#   Docker Compose (api/worker containers): postgres, redis
#   Native API/tests on your machine:       127.0.0.1 for both
#
# Windows quick setup:  .\scripts\setup-local-dev.ps1
# Full guide:           docs/LOCAL_DEVELOPMENT.md
# -----------------------------------------------------------------------------

APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (required for API and DB-backed tests) ---
# Compose (containers): host = postgres
# Native host → Compose Postgres: host = 127.0.0.1
DATABASE_URL=postgresql+psycopg2://trustlens:trustlens@postgres:5432/trustlens
# DATABASE_URL=postgresql+psycopg2://trustlens:trustlens@127.0.0.1:5432/trustlens
POSTGRES_USER=trustlens
POSTGRES_PASSWORD=trustlens
POSTGRES_DB=trustlens
POSTGRES_PORT=5432

# --- Dedicated TEST database (required to run backend DB-backed pytest) ---
# MUST be a distinctly-named database, never DATABASE_URL/POSTGRES_DB above —
# backend/tests/conftest.py refuses to run (including the destructive Alembic
# migration round-trip) against a database named "trustlens" or identical to
# DATABASE_URL. Create it once against the same Postgres server, e.g.:
#   docker compose exec postgres createdb -U trustlens trustlens_test
TEST_DATABASE_URL=postgresql+psycopg2://trustlens:trustlens@127.0.0.1:5432/trustlens_test

# --- Redis (optional for API health; required for evaluation enqueue) ---
# Compose host = redis; native = 127.0.0.1
REDIS_URL=redis://redis:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PORT=6379

# --- Artifact storage (evidence, dataset content, reports) ---
# Local directory; API and worker must share it. Compose overrides this to a
# shared volume (/data/artifacts). Native runs: use an absolute path so the
# API (run from backend/) and worker (run from worker/) resolve the same dir.
# Unset = storage disabled. Tests always use a temp dir.
STORAGE_DIR=./data/artifacts

# Optional — Hugging Face Hub token (Phase 6 model import). Only required for
# gated/private repos; public model metadata import works without it.
HF_TOKEN=

# Worker heartbeat interval (seconds) — only used by the deprecated heartbeat shell
WORKER_HEARTBEAT_SECONDS=30

# Celery producer (Phase 7). Set true only for special eager-mode experiments;
# normal compose/tests leave this false and mock enqueue or call the pipeline directly.
CELERY_TASK_ALWAYS_EAGER=false

# Report PDF projection (Phase 19). The API image ships WeasyPrint OS libs
# (Pango/HarfBuzz); set false to skip PDFs — reports then return pdf_uri=null
# and remain JSON (canonical) + HTML only.
REPORT_PDF_ENABLED=true
