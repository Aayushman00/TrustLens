      "inputs": { "O": 0, "S": 9, "D": 9 },
      "expected": { "Pi": 0, "aspect_Ti": 0 }
    },
    {
      "id": 4,
      "name": "Veto on Detection",
      "inputs": { "O": 8, "S": 8, "D": 0 },
      "expected": { "Pi": 0, "aspect_Ti": 0 }
    },
    {
      "id": 5,
      "name": "All tens optimal candidate",
