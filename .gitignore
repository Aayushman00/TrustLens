# =============================================================================
# TrustLens — root .gitignore
# Stack: Python (FastAPI/Celery) + React/Vite + Docker + PostgreSQL/Redis
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & local environment (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
credentials.json
service-account*.json

# -----------------------------------------------------------------------------
# Python — backend, worker, shared
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build
build/
dist/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
*.manifest
*.spec

# Test & type tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytype/
.dmypy.json
dmypy.json
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Jupyter (if used for experiments)
.ipynb_checkpoints/
*.ipynb_checkpoints

# Celery
celerybeat-schedule
celerybeat.pid

# -----------------------------------------------------------------------------
# Node / frontend (Vite + React + TypeScript)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vite / build output
frontend/dist/
frontend/dist-ssr/
*.local

# Frontend test / tooling caches
frontend/.vite/
frontend/coverage/

# -----------------------------------------------------------------------------
# Docker & local infrastructure data (Phase 2+)
# -----------------------------------------------------------------------------
docker-compose.override.yml
.docker/
postgres-data/
redis-data/
minio-data/
pgdata/
data/postgres/
data/redis/
data/minio/

# -----------------------------------------------------------------------------
# TrustLens runtime artifacts (evaluations, evidence, reports)
# -----------------------------------------------------------------------------
artifacts/
evidence/
reports/generated/
/storage/
tmp/
temp/
.cache/
uploads/
downloads/

# Hugging Face & ML model caches (large; use HF_HOME outside repo)
.huggingface/
hf_cache/
model_cache/
checkpoints/
*.pt
*.pth
*.onnx
*.safetensors
*.bin
!shared/scoring/fixtures/*.json

# WeasyPrint / PDF temp files
*.pdf.tmp

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/
log/

# -----------------------------------------------------------------------------
# Editors & IDEs
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Cursor
.cursor/*
.claude/
.codegraph/

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.tmp
*.temp
.sass-cache/

# Local experiment outputs (keep structured results in git only if intentional)
experiment_runs/
benchmark_outputs/
# Flawed-model suite: track result JSON, cards, data manifests, model
# manifests/configs; never the weights or training scratch (GBs).
results/flawed_model_suite/models/**/*.safetensors
results/flawed_model_suite/models/**/*.bin
results/flawed_model_suite/models/**/tokenizer.json
results/flawed_model_suite/models/**/_trainer_tmp/
results/flawed_model_suite/data/*_train.jsonl
# Round 3 L5 confirmatory fairness setup: same policy (data reproducible from --seed).
results/fairness_confirm_*/models/**/*.safetensors
results/fairness_confirm_*/models/**/tokenizer.json
results/fairness_confirm_*/models/**/_trainer_tmp/
results/fairness_confirm_*/data/*_train.jsonl
results/osd_calibration_*/calibration/models/**/*.safetensors
results/osd_calibration_*/calibration/models/**/tokenizer.json
results/osd_calibration_*/calibration/models/**/_trainer_tmp/
results/osd_calibration_*/calibration/data/*_train.jsonl
# Exported TrustLens reports (JSON+PDF) and raw evidence per experiment run.
*.log


# -----------------------------------------------------------------------------
# Research notes & non-code docs (keep repo code-only)
# -----------------------------------------------------------------------------
FRIES_Visual_Guide.md
FRIES_Trust_Score_Notes.md
document.md
papers/
implementation/
docs/TRUSTLENS_*.md
stitch*/
# Round 3: tokenizer vocab copies (30k lines each) and generated eval sets
# (reproducible from --seed) bloat PR diffs; keep manifests/results only.
results/**/models/**/vocab.txt
results/**/data/eval_set.csv
results/**/data/eval_set.jsonl

# Regenerable per-run exports (TrustLens evidence/report JSON+PDF) and build output.
results/**/artifacts/
results/**/*.pdf
report/main.pdf
report/*.aux
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
# AI-generated planning docs
docs/superpowers/

# Flawed-model suite: raw per-run dumps are regenerable; keep analysis/summary/cards/ground truth.
results/flawed_model_suite/final_*_repeat5*/
results/flawed_model_suite/sweep_*/
results/flawed_model_suite/smoke_*/
results/flawed_model_suite/hub_2026*/
results/flawed_model_suite/hub_final_c*/
results/flawed_model_suite/eval_results/
results/flawed_model_suite/eval_results_v2/
results/flawed_model_suite/human_validation_*/*.json
